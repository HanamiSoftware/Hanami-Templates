<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0"
            Type="Item"
            xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">

  <TemplateData>
    <Name>Hanami Javascript File</Name>
    <Description>JavaScript file with Hanami Software information</Description>
    <ProjectType>JavaScript</ProjectType>
    <SortOrder>1000</SortOrder>
    <DefaultName>HanamiFile.js</DefaultName>
  </TemplateData>

  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.js">
      Hanami Javascript File.js
    </ProjectItem>
  </TemplateContent>

</VSTemplate>